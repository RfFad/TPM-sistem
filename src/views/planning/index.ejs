<script>
function hitungTarget() {

    let cycleTime = parseFloat($('#cycle_time').val()) || 0;
    let cavity = parseFloat($('#cavity').val()) || 0;

    const jamPerShift = 7;
    const jumlahShift = 3;

    if (cycleTime <= 0 || cavity <= 0) {

        $('#target_hour').val('');
        $('#target_shift').val('');
        $('#target_day').val('');

        return;
    }

    // Target per jam
    let targetHour =
        (3600 / cycleTime) * cavity;

    // Target per shift
    let targetShift =
        targetHour * jamPerShift;

    // Target per hari
    let targetDay =
        targetShift * jumlahShift;

    $('#target_hour').val(
        Math.floor(targetHour)
    );

    $('#target_shift').val(
        Math.floor(targetShift)
    );

    $('#target_day').val(
        Math.floor(targetDay)
    );
}


// Hitung ketika Cycle Time berubah
$('#cycle_time').on('input', function () {
    hitungTarget();
});


// Hitung ketika Cavity berubah
$('#cavity').on('input', function () {
    hitungTarget();
});
$('#id_produk').on('change', function () {

    let option = $(this).find('option:selected');

    let cycleTime =
        option.data('cycle-time');

    let cavity =
        option.data('cavity');

    $('#cycle_time').val(cycleTime);
    $('#cavity').val(cavity);

    hitungTarget();
});
$(document).ready(function () {

    setDefaultTanggal();
    loadPlanning();
    loadProduk();
    loadProdukFilter();

    $('#id_produk').select2({
    theme: 'bootstrap4',
    placeholder: 'Pilih Produk',
    allowClear: true,
    width: '100%',
    dropdownParent: $('#modal-default')
});

});

/* ==================================
   LOAD DATA PLANNING
================================== */
function loadPlanning() {

    const tanggal = $('#filterTanggal').val();
    const bulan   = $('#filterBulan').val();
    const tahun   = $('#filterTahun').val();
    const produk  = $('#filterProduk').val();
    const mesin   = $('#filterMesin').val();

    $.ajax({

        url: '/planning/data',

        type: 'GET',

        data: {
            tanggal: $('#filterTanggal').val(),
            bulan: bulan,
            tahun: tahun,
            produk: produk,
            mesin: mesin
        },

        success: function (res) {

            let data = res.data || [];

            let html = `
            <table id="tblPlanning"
                   class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>No</th>
                        <th>Tanggal</th>
                        <th>Produk</th>
                        <th>Mesin</th>
                        <th>Tonage</th>
                        <th>Cycle Time</th>
                        <th>Cavity</th>
                        <th>Target Shift</th>
                        <th>Target Day</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
            `;

            data.forEach((d, i) => {

                html += `
                <tr>

                    <td>${i + 1}</td>
                    <td>${formatDate(d.tgl)}</td>
                    <td>${d.nama_produk}</td>
                    <td>${d.no_mc}</td>
                    <td>${d.tonage}</td>
                    <td>${d.cycle_time}</td>
                    <td>${d.cavity}</td>
                    <td>${d.target_shift}</td>
                    <td>${Number(d.target_day).toLocaleString('id-ID')}</td>

                    <td>

                        <button
                            class="btn btn-info btn-sm"
                            onclick="detailData(${d.id_plan})">
                            Detail
                        </button>

                        <button
                            class="btn btn-warning btn-sm"
                            onclick="editData(${d.id_plan})">
                            Edit
                        </button>

                        <button
                            class="btn btn-danger btn-sm"
                            onclick="removeData(${d.id_plan})">
                            Hapus
                        </button>

                    </td>

                </tr>
                `;
            });

            html += `
                </tbody>
            </table>
            `;

            $('#tablePlanning').html(html);

            $('#tblPlanning').DataTable({
                destroy: true,
                responsive: true,
                pageLength: 25
            });

        }

    });

}
/* ==================================
   TAMBAH DATA
================================== */
$('#btnCreate').click(function () {

    $.ajax({

        url: '/planning/save',

        type: 'POST',

        data: $('#formPlanning').serialize(),

        beforeSend: function () {

            Swal.fire({
                title: 'Menyimpan...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

        },

        success: function (res) {

            Swal.fire({
                icon: 'success',
                title: 'Berhasil',
                text: res.message
            });

            $('#modal-default').modal('hide');

            loadPlanning();

        },

        error: function (xhr) {

            Swal.fire({
                icon: 'error',
                title: 'Gagal',
                text: xhr.responseJSON?.message || 'Terjadi kesalahan'
            });

        }

    });

});

/* ==================================
   EDIT DATA
================================== */
function editData(id) {

    $.ajax({

        url: '/planning/get/' + id,

        type: 'GET',

        success: function (data) {

            $('#id_plan').val(data.id_plan);

                // pilih produk sesuai id_produk
            $('#id_produk').val(data.id_produk);

            // jika menggunakan Select2
        $('#id_produk').trigger('change');
const tgl = new Date(data.tgl);
tgl.setMinutes(tgl.getMinutes() - tgl.getTimezoneOffset());
$('#tgl').val(tgl.toISOString().split('T')[0]);

            $('#no_mc').val(data.no_mc);

            $('#tonage').val(data.tonage);

            $('#cycle_time').val(data.cycle_time);

            $('#cavity').val(data.cavity);

            $('#target_shift').val(data.target_shift);

            $('#target_hour').val(data.target_hour);

            $('#target_day').val(data.target_day);

            $('#keterangan').val(data.keterangan);

            $('#btnCreate').hide();
            $('#btnUpdate').show();

            $('.modal-title').text('Edit Planning');

            $('#modal-default').modal('show');

        }

    });

}

/* ==================================
   UPDATE
================================== */
$('#btnUpdate').click(function () {

    $.ajax({

        url: '/planning/update',

        type: 'PUT',

        data: $('#formPlanning').serialize(),

        beforeSend: function () {

            Swal.fire({
                title: 'Mengupdate...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

        },

        success: function (res) {

            Swal.fire({
                icon: 'success',
                title: 'Berhasil',
                text: res.message
            });

            $('#modal-default').modal('hide');

            loadPlanning();

        },

        error: function (xhr) {

            Swal.fire({
                icon: 'error',
                title: 'Gagal',
                text: xhr.responseJSON?.message || 'Terjadi kesalahan'
            });

        }

    });

});

/* ==================================
   HAPUS
================================== */
function removeData(id) {

    Swal.fire({

        title: 'Yakin?',
        text: 'Data akan dihapus',

        icon: 'warning',

        showCancelButton: true,

        confirmButtonText: 'Ya'

    }).then((result) => {

        if (result.isConfirmed) {

            $.ajax({

                url: '/planning/delete/' + id,

                type: 'DELETE',

                success: function (res) {

                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil',
                        text: res.message
                    });

                    loadPlanning();

                }

            });

        }

    });

}

/* ==================================
   DETAIL
================================== */
function detailData(id) {

    $.get('/planning/get/' + id, function (d) {

        Swal.fire({

            title: 'Detail Planning',

            html: `
                <table class="table table-bordered">

                    <tr>
                        <td>Produk</td>
                        <td>${d.nama_produk || '-'}</td>
                    </tr>

                    <tr>
                        <td>Tanggal</td>
                        <td>${formatDate(d.tgl)}</td>
                    </tr>

                    <tr>
                        <td>Mesin</td>
                        <td>${d.no_mc}</td>
                    </tr>

                    <tr>
                        <td>Tonage</td>
                        <td>${d.tonage}</td>
                    </tr>

                    <tr>
                        <td>Cycle Time</td>
                        <td>${d.cycle_time}</td>
                    </tr>

                    <tr>
                        <td>Cavity</td>
                        <td>${d.cavity}</td>
                    </tr>

                    <tr>
                        <td>Target Shift</td>
                        <td>${d.target_shift}</td>
                    </tr>

                    <tr>
                        <td>Target Day</td>
                        <td>${d.target_day}</td>
                    </tr>

                    <tr>
                        <td>Keterangan</td>
                        <td>${d.keterangan || '-'}</td>
                    </tr>

                </table>
            `,

            width: 800

        });

    });

}

/* ==================================
   RESET MODAL
================================== */
$('#modal-default').on('hidden.bs.modal', function () {

    $('#formPlanning')[0].reset();

    $('#id_plan').val('');

    $('#btnCreate').show();

    $('#btnUpdate').hide();

});

/* ==================================
   FORMAT TANGGAL
================================== */
function formatDate(date) {

    if (!date) return '-';

    return new Date(date).toLocaleDateString('id-ID', {

        year: 'numeric',
        month: '2-digit',
        day: '2-digit'

    });

}
function loadProduk() {

    $.ajax({
        url: '/produk/data',
        type: 'GET',
        success: function(res) {

            let html = '<option value="">Pilih Produk</option>';

            const data = res.data || res;

            data.forEach(item => {

                html += `
                    <option value="${item.id_produk}">
                        ${item.nama_produk} | ${item.no_part} | ${item.material}
                    </option>
                `;

            });

            $('#id_produk').html(html);

        }
    });

}
$('#btnFilter').click(function(){

    let tanggal = $('#filterTanggal').val();
    let bulan   = $('#filterBulan').val();
    let tahun   = $('#filterTahun').val();
    let produk  = $('#filterProduk').val();
    let mesin   = $('#filterMesin').val();

    loadPlanning(
        tanggal,
        bulan,
        tahun,
        produk,
        mesin
    );

});
function loadProdukFilter() {

    $.ajax({
        url: '/produk/data',
        type: 'GET',
        success: function(res) {

            let html = '<option value="">Pilih Produk</option>';

            const data = res.data || res;

            data.forEach(item => {

                html += `
                    <option value="${item.id_produk}">
                        ${item.nama_produk} | ${item.no_part} | ${item.material}
                    </option>
                `;

            });

            $('#filterProduk').html(html);

        }
    });

}

function setDefaultTanggal() {

    const today = new Date();

    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const day = String(today.getDate()).padStart(2, '0');

    const tanggal = `${year}-${month}-${day}`;

    $('#filterTanggal').val(tanggal);

}
$('#modal-default').on('hidden.bs.modal', function () {

    $('#formPlanning')[0].reset();

    $('#id_plan').val('');

    $('#btnCreate').show();

    $('#btnUpdate').hide();

    // paksa hapus backdrop
    $('.modal-backdrop').remove();

