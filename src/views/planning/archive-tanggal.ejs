<%- include("../partials/header") %>
<%- include("../partials/sideNavbar") %>
<style>
.planning-table {

    width: 100%;
    border-collapse: collapse;
    font-size: 10px;
    white-space: nowrap;

}

.planning-table th,
.planning-table td {

    border: 1px solid #000 !important;
    padding: 2px 4px;
    vertical-align: middle;
    text-align: center;

}

.planning-table thead th {

    background: #fff;
    font-weight: 700;

}

.planning-table td.text-left {

    text-align: left !important;

}

.planning-table tbody tr:hover {

    background: #f5f5f5;

}

.total-row {

    background: #e9ecef;
    font-weight: bold;
    font-size: 11px;

}

.planning-table th:nth-child(1){
    width:40px;
}

.planning-table th:nth-child(2){
    width:55px;
}

.planning-table th:nth-child(3){
    width:120px;
}

.planning-table th:nth-child(4){
    width:120px;
}

.planning-table th:nth-child(5){
    width:90px;
}

.planning-table th:nth-child(6){
    width:50px;
}

.planning-table th:nth-child(7){
    width:60px;
}

.planning-table th:nth-child(8),
.planning-table th:nth-child(9),
.planning-table th:nth-child(10),
.planning-table th:nth-child(11),
.planning-table th:nth-child(12){

    width:90px;

}

.planning-table th:nth-child(13){
    width:140px;
}
</style>
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="#">Home</a></li>
              <li class="breadcrumb-item active">Produk</li>
            </ol>
          </div>
        </div>
      </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
           

            <div class="card">
              <div class="card-header">
               
              <div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
                <a href="/planning/archive" class="back-btn">
    <i class="fas fa-arrow-left mr-1"></i>
    Kembali
</a>
              </div>
              <!-- /.card-header -->
          <div class="card-body">
 <div class="row">

    <% data.forEach(item => { %>

        <div class="col-md-3">

            <div class="card card-success shadow">

                <div class="card-body text-center">

                    <i class="fas fa-calendar-day fa-2x mb-3"></i>

                    <h5>
                        <%= new Date(item.tgl).toLocaleDateString('id-ID') %>
                    </h5>

                    <span class="badge badge-primary">
                        <%= item.total_plan %> Planning
                    </span>

                    <hr>

                   <%
const d = new Date(item.tgl);

const tglUrl =
    d.getFullYear() + '-' +
    String(d.getMonth() + 1).padStart(2, '0') + '-' +
    String(d.getDate()).padStart(2, '0');
%>

<a href="/planning/dataplan/<%= tglUrl %>"
   class="btn btn-success btn-block">

    Buka Planning

</a>
                </div>

            </div>

        </div>

    <% }) %>

</div>
</div>

              <!-- /.card-body -->
            </div>
            <!-- /.card -->
          </div>
          <!-- /.col -->
        </div>
        <!-- /.row -->
      </div>
      <!-- /.container-fluid -->
    </section>
    <!-- /.content -->
  </div>

<%- include("../partials/footer") %>
