<%- include("../partials/footer") %>
<script>
    let currentPlanId = null;
    
    let currentTargetHour = 0;
    
    let currentTargetShift = 0;


$('#btnIsiSummary').click(function (){
    $('.isi-summary').toggleClass('d-none').fadeIn(500);
})  

$('#btnIsiSummary').click(function () {

    //$('.isi-summary').toggleClass('d-none');

    if ($('.isi-summary').hasClass('d-none')) {

        $(this).text('Tampilkan Detail');

    } else {

        $(this).text('Sembunyikan Detail');

    }

});
$('.status-select').each(function () {

    $(this).val('Running');

    const shift = $(this).data('shift');

    $('#detailKendalaRow' + shift).hide();
    $('#kendalaShift' + shift).val('');

});

$(document).on(
    'input',
    '.actual-input, .downtime-input',
    function () {

        const shift =
            $(this).data('shift');


        calculateShift(shift);

        calculateTotal();

    }
);


function formatNumber(number) {

    return Number(number || 0)
        .toLocaleString('id-ID');

}

function calculateShift(shift) {

    const target =
        Number(
            $('#targetShift' + shift).val()
        ) || 0;


    const actual =
        Number(
            $('#actualShift' + shift).val()
        ) || 0;


    const downtime =
        Number(
            $('#downtimeShift' + shift).val()
        ) || 0;


    // ==========================================
    // TARGET YANG HILANG KARENA DOWNTIME
    // ==========================================

    const targetLoss =
        currentTargetHour *
        (downtime / 60);


    // ==========================================
    // TARGET EFEKTIF
    // ==========================================

    const effectiveTarget =
        Math.max(
            target - targetLoss,
            0
        );


    // ==========================================
    // MINUS
    // ==========================================

    const minus =
        Math.max(
            effectiveTarget - actual,
            0
        );


    // ==========================================
    // ACHIEVEMENT
    // ==========================================

    let achievement = 0;


    if (effectiveTarget > 0) {

        achievement =
            (
                actual /
                effectiveTarget
            ) * 100;

    }


    // ==========================================
    // TAMPILKAN
    // ==========================================

    $('#effectiveTargetShift' + shift)
        .text(
            formatNumber(
                Math.round(effectiveTarget)
            )
        );


    $('#minusShift' + shift)
        .text(
            formatNumber(
                Math.round(minus)
            )
        );


    $('#achievementShift' + shift)
        .text(
            achievement.toFixed(2) + '%'
        );

}

function calculateTotal() {

    let totalTarget = 0;

    let totalActual = 0;

    let totalDowntime = 0;

    let totalEffectiveTarget = 0;

    let totalMinus = 0;


    for (
        let shift = 1;
        shift <= 3;
        shift++
    ) {

        const target =
            Number(
                $('#targetShift' + shift).val()
            ) || 0;


        const actual =
            Number(
                $('#actualShift' + shift).val()
            ) || 0;


        const downtime =
            Number(
                $('#downtimeShift' + shift).val()
            ) || 0;


        const targetLoss =
            currentTargetHour *
            (downtime / 60);


        const effectiveTarget =
            Math.max(
                target - targetLoss,
                0
            );


        const minus =
            Math.max(
                effectiveTarget - actual,
                0
            );


        totalTarget += target;

        totalActual += actual;

        totalDowntime += downtime;

        totalEffectiveTarget +=
            effectiveTarget;

        totalMinus += minus;

    }


    let achievement = 0;


    if (
        totalEffectiveTarget > 0
    ) {

        achievement =
            (
                totalActual /
                totalEffectiveTarget
            ) * 100;

    }


    $('#totalTarget')
        .text(
            formatNumber(
                Math.round(totalTarget)
            )
        );


    $('#totalActual')
        .text(
            formatNumber(
                Math.round(totalActual)
            )
        );


    $('#totalDowntime')
        .text(
            formatNumber(totalDowntime)
        );


    $('#totalEffectiveTarget')
        .text(
            formatNumber(
                Math.round(
                    totalEffectiveTarget
                )
            )
        );


    $('#totalMinus')
        .text(
            formatNumber(
                Math.round(totalMinus)
            )
        );


    $('#totalAchievement')
        .text(
            achievement.toFixed(2)
            + '%'
        );

}
$(document).on(
    'change',
    '.status-select',
    function () {

        const shift =
            $(this).data('shift');


        const status =
            $(this).val();


        if (status === 'Pending') {

            $('#detailKendalaRow' + shift)
                .show();

        } else {

            $('#detailKendalaRow' + shift)
                .hide();


            $('#kendalaShift' + shift)
                .val('');

        }

    }
);
$(document).on(
    'click',
    '.btn-summary',
    function () {

        const button =
            $(this);


        currentPlanId =
            button.data('id');


        if (!currentPlanId) {

            alert(
                'ID Planning tidak ditemukan'
            );

            return;

        }


        $('#summaryIdPlan')
            .val(currentPlanId);


        $('#summaryNamaPart')
            .val(
                button.data('part') || '-'
            );


        $('#summaryMC')
            .val(
                button.data('mc') || '-'
            );


        // =====================================
        // RESET
        // =====================================

        for (
            let shift = 1;
            shift <= 3;
            shift++
        ) {

            $('#idSummary' + shift)
                .val('');

            $('#actualShift' + shift)
                .val(0);

            $('#downtimeShift' + shift)
                .val(0);

            $('#statusShift' + shift)
                .val('Pending');

            $('#kendalaShift' + shift)
                .val('');

            $('#keteranganShift' + shift)
                .val('');

            $('#detailKendalaRow' + shift)
                .hide();

        }


        // =====================================
        // AJAX GET
        // =====================================

        $.ajax({

            url:
                '/summary/summary-planning/plan/'
                + currentPlanId,

            type: 'GET',

            dataType: 'json',


            success: function (response) {

                console.log(
                    'SUMMARY RESPONSE:',
                    response
                );


                if (!response.success) {

                    alert(
                        response.message
                    );

                    return;

                }


                // =================================
                // DATA PLANNING
                // =================================

                currentTargetHour =
                    Number(
                        response.planning.target_hour
                    ) || 0;


                currentTargetShift =
                    Number(
                        response.planning.target_shift
                    ) || 0;


                // =================================
                // TARGET SEMUA SHIFT
                // =================================

                for (
                    let shift = 1;
                    shift <= 3;
                    shift++
                ) {

                    $('#targetShift' + shift)
                        .val(
                            currentTargetShift
                        );

                }


                // =================================
                // DATA SUMMARY
                // =================================

                if (
                    response.data &&
                    response.data.length > 0
                ) {

                    response.data.forEach(
                        function (item) {

                            const shift =
                                Number(
                                    item.shift
                                );


                            $('#idSummary' + shift)
                                .val(
                                    item.id_summary
                                );


                            $('#actualShift' + shift)
                                .val(
                                    item.actual_qty
                                );


                            $('#downtimeShift' + shift)
                                .val(
                                    item.downtime_minute
                                );


                            $('#statusShift' + shift)
                                .val(
                                    item.status
                                );


                            $('#kendalaShift' + shift)
                                .val(
                                    item.kendala
                                );


                            $('#keteranganShift' + shift)
                                .val(
                                    item.keterangan
                                );


                            if (
                                item.status ===
                                'Pending'
                            ) {

                                $('#detailKendalaRow' + shift)
                                    .show();

                            }

                        }
                    );

                }


                // =================================
                // HITUNG
                // =================================

                for (
                    let shift = 1;
                    shift <= 3;
                    shift++
                ) {

                    calculateShift(shift);

                }


                calculateTotal();


                // =================================
                // BUKA MODAL
                // =================================

                $('#modalSummary')
                    .modal('show');

            },


            error: function (xhr) {

                console.error(
                    'GET SUMMARY ERROR:',
                    xhr
                );


                console.error(
                    'RESPONSE:',
                    xhr.responseText
                );


                alert(
                    'Gagal mengambil data Summary. '
                    + 'Status: '
                    + xhr.status
                );

            }

        });

    }
);
$('#btnSaveSummary').on(
    'click',
    function () {

        const button =
            $(this);


        button
            .prop('disabled', true)
            .html(
                '<i class="fas fa-spinner fa-spin"></i> Menyimpan...'
            );


        const shifts = [
            1,
            2,
            3
        ];


        saveShift(
            shifts,
            0,
            button
        );

    }
);
function saveShift(
    shifts,
    index,
    button
) {

    // =========================================
    // SEMUA SHIFT SELESAI
    // =========================================

    if (
        index >= shifts.length
    ) {

        button
            .prop('disabled', false)
            .html(
                '<i class="fas fa-save"></i> Simpan Summary'
            );


        alert(
            'Summary berhasil disimpan'
        );


        $('#modalSummary')
            .modal('hide');


        return;

    }


    const shift =
        shifts[index];


    const idSummary =
        $('#idSummary' + shift)
            .val();


    const actual =
        $('#actualShift' + shift)
            .val();


    const downtime =
        $('#downtimeShift' + shift)
            .val();


    const status =
        $('#statusShift' + shift)
            .val();


    const kendala =
        $('#kendalaShift' + shift)
            .val();


    const keterangan =
        $('#keteranganShift' + shift)
            .val();


    // =========================================
    // TENTUKAN INSERT / UPDATE
    // =========================================

    if (idSummary) {

        // UPDATE

        $.ajax({

            url:
                '/summary/summary-planning/update',

            type: 'PUT',

            dataType: 'json',

            data: {

                id_summary:
                    idSummary,

                actual_qty:
                    actual,

                downtime_minute:
                    downtime,

                status:
                    status,

                kendala:
                    kendala,

                keterangan:
                    keterangan

            },


            success: function (response) {

                if (!response.success) {

                    button
                        .prop('disabled', false)
                        .html(
                            '<i class="fas fa-save"></i> Simpan Summary'
                        );


                    alert(
                        response.message
                    );

                    return;

                }


                // LANJUT SHIFT BERIKUTNYA

                saveShift(
                    shifts,
                    index + 1,
                    button
                );

            },


            error: function (xhr) {

                console.error(
                    xhr.responseText
                );


                button
                    .prop('disabled', false)
                    .html(
                        '<i class="fas fa-save"></i> Simpan Summary'
                    );


                alert(
                    'Gagal update Shift '
                    + shift
                );

            }

        });

    }

    else {

        // INSERT

        $.ajax({

            url:
                '/summary/summary-planning/save',

            type: 'POST',

            dataType: 'json',

            data: {

                id_plan:
                    currentPlanId,

                shift:
                    shift,

                actual_qty:
                    actual,

                downtime_minute:
                    downtime,

                status:
                    status,

                kendala:
                    kendala,

                keterangan:
                    keterangan

            },


            success: function (response) {

                if (!response.success) {

                    button
                        .prop('disabled', false)
                        .html(
                            '<i class="fas fa-save"></i> Simpan Summary'
                        );


                    alert(
                        response.message
                    );

                    return;

                }


                // Simpan ID SUMMARY

                $('#idSummary' + shift)
                    .val(
                        response.id_summary
                    );


                // LANJUT SHIFT

                saveShift(
                    shifts,
                    index + 1,
                    button
                );

            },


            error: function (xhr) {

                console.error(
                    xhr.responseText
                );


                button
                    .prop('disabled', false)
                    .html(
                        '<i class="fas fa-save"></i> Simpan Summary'
                    );


                alert(
                    'Gagal menyimpan Shift '
                    + shift
                );

            }

        });

    }

}
 $('#btnLihatSummary').on('click', function () { window.location.href = '/summary-planning'; });
 $('#btnIsiSummary').on('click', function () { 
$('.summary-input').toggle(); }); 
$('#btnPrint').on('click', function () { window.print(); });
</script>
