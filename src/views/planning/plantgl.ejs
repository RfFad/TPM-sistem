<style>
.planning-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10px;
    white-space: nowrap;
}

.planning-table th,
.planning-table td {
    border: 1px solid #000 !important;
    padding: 2px 4px;
    vertical-align: middle;
    text-align: center;
}

.planning-table thead th {
    background: #fff;
    font-weight: 700;
}

.planning-table td.text-left {
    text-align: left !important;
}

.planning-table tbody tr:hover {
    background: #f5f5f5;
}

.total-row {
    background: #e9ecef;
    font-weight: bold;
    font-size: 11px;
}

   
@media print {

    body * {
        visibility: hidden;
    }

    #printArea,
    #printArea * {
        visibility: visible;
    }

    #printArea {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        border: none !important;
        box-shadow: none !important;
    }

    #actionButtons,
    .btn-summary,
    #summaryInputArea,
    footer {
        display: none !important;
    }

}


.planning-table th:nth-child(1){ width:40px; }
.planning-table th:nth-child(2){ width:55px; }
.planning-table th:nth-child(3){ width:120px; }
.planning-table th:nth-child(4){ width:120px; }
.planning-table th:nth-child(5){ width:90px; }
.planning-table th:nth-child(6){ width:50px; }
.planning-table th:nth-child(7){ width:60px; }
.planning-table th:nth-child(8),
.planning-table th:nth-child(9),
.planning-table th:nth-child(10),
.planning-table th:nth-child(11),
.planning-table th:nth-child(12){
    width:90px;
}
.planning-table th:nth-child(13){
    width:140px;
}
</style>

