<%- include('partials/header', { title: title, active: active }) %>
<%- include('partials/filterbar') %>

<div id="pageContent">
<div class="card mb-4">
  <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span>Data Produksi Harian</span>
    <input type="search" class="form-control form-control-sm" id="fSearch" placeholder="Cari part / material..." style="max-width:260px">
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 small" id="tblData">
      <thead><tr>
        <th>Tanggal</th><th>Mesin</th><th>Part</th><th>Customer</th>
        <th class="text-end">OK</th><th class="text-end">NG</th><th class="text-end">Total</th>
        <th class="text-end">Plan (jam)</th><th class="text-end">DT (jam)</th>
        <th class="text-end">A</th><th class="text-end">P</th><th class="text-end">Q</th><th class="text-end">OEE</th><th></th>
      </tr></thead>
      <tbody></tbody>
    </table>
  </div>
  <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span class="small text-muted" id="pageInfo"></span>
    <div class="btn-group btn-group-sm">
      <button class="btn btn-outline-secondary" id="btnPrev" type="button"><i class="bi bi-chevron-left"></i></button>
      <button class="btn btn-outline-secondary" id="btnNext" type="button"><i class="bi bi-chevron-right"></i></button>
    </div>
  </div>
</div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Detail Produksi</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body" id="detailBody"></div>
    </div>
  </div>
</div>

<%- include('partials/footer', { script: 'data' }) %>
