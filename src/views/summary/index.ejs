<style>

.summary-page {
    background: #f4f6f9;
}

/* =========================
   HEADER
========================= */

.summary-title {
    font-weight: 700;
    margin-bottom: 2px;
}

.summary-subtitle {
    color: #6c757d;
    font-size: 14px;
}

/* =========================
   FILTER
========================= */

.filter-box {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 10px 14px;
    height: 100%;
}

.filter-box label {
    display: block;
    font-size: 11px;
    color: #6c757d;
    margin-bottom: 3px;
}

.filter-box strong {
    font-size: 13px;
}

/* =========================
   KPI
========================= */

.kpi-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 15px;
    min-height: 105px;
    position: relative;
    overflow: hidden;
}

.kpi-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 18px;
    float: left;
    margin-right: 10px;
}

.kpi-title {
    font-size: 11px;
    color: #52606d;
    font-weight: 600;
}

.kpi-value {
    font-size: 23px;
    font-weight: 700;
    line-height: 28px;
}

.kpi-info {
    clear: both;
    padding-top: 9px;
    font-size: 10px;
    color: #6c757d;
}

.kpi-blue .kpi-icon {
    background: #2196f3;
}

.kpi-green .kpi-icon {
    background: #20a464;
}

.kpi-teal .kpi-icon {
    background: #12a67a;
}

.kpi-red .kpi-icon {
    background: #e5485d;
}

.kpi-purple .kpi-icon {
    background: #6755c7;
}

.kpi-orange .kpi-icon {
    background: #f39c12;
}

.kpi-cyan .kpi-icon {
    background: #22afd0;
}

.kpi-gray .kpi-icon {
    background: #60758a;
}

/* =========================
   CARD
========================= */

.dashboard-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 15px;
}

.dashboard-card-title {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 10px;
    color: #19324d;
}

.chart-wrapper {
    position: relative;
    width: 100%;
    height: 270px;
}

.chart-wrapper-small {
    height: 220px;
}

/* =========================
   MINI KPI
========================= */

.mini-kpi {
    border: 1px solid #e5e7eb;
    border-radius: 7px;
    padding: 10px;
    height: 75px;
}

.mini-kpi-title {
    font-size: 10px;
    color: #6c757d;
}

.mini-kpi-value {
    font-size: 18px;
    font-weight: 700;
}

/* =========================
   TABLE
========================= */

.summary-table {
    width: 100%;
    font-size: 11px;
}

.summary-table th {
    background: #f1f5f9;
    color: #29415a;
    font-weight: 700;
}

.summary-table td,
.summary-table th {
    padding: 7px 6px;
    vertical-align: middle;
}

.status {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 5px;
    color: #fff;
    font-size: 10px;
    font-weight: 600;
}

.status-running {
    background: #18a866;
}

.status-pending {
    background: #f5a623;
}

.status-finish {
    background: #2196f3;
}

/* =========================
   OEE
========================= */

.oee-box {
    text-align: center;
    padding: 5px;
}

.oee-circle {
    width: 115px;
    height: 115px;
    margin: auto;
    position: relative;
}

.oee-circle canvas {
    width: 115px !important;
    height: 115px !important;
}

.oee-center {
    position: absolute;
    top: 38px;
    left: 0;
    width: 100%;
    font-size: 20px;
    font-weight: 700;
}

.oee-name {
    font-size: 11px;
    font-weight: 700;
    margin-top: 7px;
}

.oee-target {
    font-size: 9px;
    color: #6c757d;
}

/* =========================
   ATTENTION
========================= */

.attention-item {
    border-bottom: 1px solid #eee;
    padding: 9px 4px;
}

.attention-item:last-child {
    border-bottom: none;
}

.attention-title {
    font-size: 11px;
    font-weight: 700;
}

.attention-detail {
    font-size: 10px;
    color: #6c757d;
}

.pending-badge {
    background: #fff1d6;
    color: #b56b00;
    padding: 3px 7px;
    border-radius: 4px;
    font-size: 9px;
}

/* =========================
   INFO
========================= */

.info-box {
    font-size: 11px;
    color: #52606d;
    line-height: 1.6;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width: 991px) {

    .kpi-card {
        margin-bottom: 10px;
    }

    .chart-wrapper {
        height: 250px;
    }

}

</style>


