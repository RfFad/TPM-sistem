<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

$(document).ready(function () {

    const path = window.location.pathname;

    const tgl = path.split('/').pop();


    let allData = [];

    let planActualChart;
    let achievementChart;
    let ngChart;
    let downtimeChart;

    let oeeChart;
    let availabilityChart;
    let performanceChart;
    let qualityChart;


    /* =====================================
       FORMAT
    ===================================== */

    function numberFormat(number) {

        return Number(number || 0)
            .toLocaleString('id-ID');

    }


    function percentage(number) {

        return Number(number || 0)
            .toFixed(2) + '%';

    }


    function formatDate(date) {

        if (!date) return '-';

        const d = new Date(date);

        return d.toLocaleDateString('id-ID', {
            day: '2-digit',
            month: 'long',
            year: 'numeric'
        });

    }


    /* =====================================
       LOAD DATA
    ===================================== */

    function loadSummary() {

        $.get('/summary/summary-planning/data/' + tgl, function (response) {

            if (!response.success) {

                Swal.fire(
                    'Error',
                    'Data summary gagal diambil',
                    'error'
                );

                return;
            }


            allData = response.data || [];


            if (allData.length > 0) {

                $('#tanggalPlanning')
                    .text(formatDate(allData[0].tgl));

            }


            renderDashboard(allData);

        }).fail(function () {

            Swal.fire(
                'Error',
                'Gagal mengambil data summary',
                'error'
            );

        });

    }


    /* =====================================
       RENDER DASHBOARD
    ===================================== */

    function renderDashboard(data) {

        if (!data.length) {

            $('#tanggalPlanning').text('-');

            return;

        }


        let totalTarget = 0;
        let totalActual = 0;
        let totalMinus = 0;
        let totalDowntime = 0;


        data.forEach(function (row) {

            const target =
                Number(row.target_qty || row.target || 0);

            const actual =
                Number(row.actual_qty || row.actual || 0);

            const minus =
                Math.max(target - actual, 0);

            const downtime =
                Number(row.downtime_minute || 0);


            totalTarget += target;
            totalActual += actual;
            totalMinus += minus;
            totalDowntime += downtime;

        });


        const achievement =
            totalTarget > 0
                ? (totalActual / totalTarget) * 100
                : 0;


        /* =========================
           KPI
        ========================= */

        $('#kpiPlan')
            .text(numberFormat(totalTarget) + ' pcs');

        $('#kpiActual')
            .text(numberFormat(totalActual) + ' pcs');

        $('#kpiAchievement')
            .text(percentage(achievement));

        $('#kpiMinus')
            .text(numberFormat(totalMinus) + ' pcs');

        $('#kpiDowntime')
            .text(numberFormat(totalDowntime) + ' min');


        $('#miniPlan')
            .text(numberFormat(totalTarget));

        $('#miniActual')
            .text(numberFormat(totalActual));

        $('#miniAchievement')
            .text(percentage(achievement));

        $('#miniGap')
            .text(numberFormat(totalMinus));


        /* =========================
           OEE
        ========================= */

        calculateOEE(
            data,
            totalTarget,
            totalActual,
            totalDowntime
        );


        /* =========================
           TABLE
        ========================= */

        renderPlanningTable(data);

        renderRecordTable(data);

        renderAttention(data);


        /* =========================
           CHART
        ========================= */

        renderPlanActualChart(data);

        renderAchievementChart(data);

        renderNgChart(data);

        renderDowntimeChart(data);

    }


    /* =====================================
       OEE
    ===================================== */

    function calculateOEE(
        data,
        totalTarget,
        totalActual,
        totalDowntime
    ) {

        /*
         * Target shift = 315
         * Target hour = 45
         *
         * 315 / 45 = 7 jam / shift
         */

        let targetHour = 0;

        data.forEach(function (row) {

            targetHour +=
                Number(row.target_hour || 0);

        });


        /*
         * Total planned hour.
         */

        let plannedHour = 0;

        data.forEach(function (row) {

            const targetShift =
                Number(row.target_shift || 0);

            const hour =
                Number(row.target_hour || 0);

            if (hour > 0) {

                plannedHour +=
                    targetShift / hour;

            }

        });


        /*
         * Availability
         */

        let availability = 100;


        if (plannedHour > 0) {

            availability =
                ((plannedHour * 60 - totalDowntime) /
                (plannedHour * 60)) * 100;

        }


        availability =
            Math.max(0, Math.min(100, availability));


        /*
         * Target setelah downtime
         */

        const lostProduction =
            targetHour *
            (totalDowntime / 60);


        const adjustedTarget =
            Math.max(
                totalTarget - lostProduction,
                0
            );


        /*
         * Performance
         */

        let performance = 0;


        if (adjustedTarget > 0) {

            performance =
                (totalActual / adjustedTarget) * 100;

        }


        performance =
            Math.max(
                0,
                Math.min(100, performance)
            );


        /*
         * Quality
         *
         * Belum ada data Good Product / NG.
         *
         * Untuk sementara 100%.
         */

        const quality = 100;


        /*
         * OEE
         */

        const oee =
            (availability *
             performance *
             quality) / 10000;


        $('#kpiOee')
            .text(percentage(oee));

        $('#oeeValue')
            .text(percentage(oee));

        $('#availabilityValue')
            .text(percentage(availability));

        $('#performanceValue')
            .text(percentage(performance));

        $('#qualityValue')
            .text('100%');


        $('#rumusAvailability')
            .text(percentage(availability));

        $('#rumusPerformance')
            .text(percentage(performance));

        $('#rumusQuality')
            .text('100%');

        $('#rumusOee')
            .text(percentage(oee));


        createOeeChart(
            'oeeChart',
            oee
        );

        createOeeChart(
            'availabilityChart',
            availability
        );

        createOeeChart(
            'performanceChart',
            performance
        );

        createOeeChart(
            'qualityChart',
            quality
        );

    }


    /* =====================================
       OEE CIRCLE
    ===================================== */

    function createOeeChart(id, value) {

        const canvas =
            document.getElementById(id);

        if (!canvas) return;


        if (canvas.chartInstance) {

            canvas.chartInstance.destroy();

        }


        canvas.chartInstance =
            new Chart(canvas, {

                type: 'doughnut',

                data: {

                    datasets: [{

                        data: [
                            value,
                            100 - value
                        ],

                        borderWidth: 0

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    cutout: '72%',

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {
                            enabled: false
                        }

                    }

                }

            });

    }


    /* =====================================
       PLAN VS ACTUAL
    ===================================== */

    function renderPlanActualChart(data) {

        const machineData = {};


        data.forEach(function (row) {

            const machine =
                'MC-' + row.no_mc;

            if (!machineData[machine]) {

                machineData[machine] = {
                    target: 0,
                    actual: 0
                };

            }


            machineData[machine].target +=
                Number(row.target_qty || 0);

            machineData[machine].actual +=
                Number(row.actual_qty || 0);

        });


        const labels =
            Object.keys(machineData);

        const target =
            labels.map(function (x) {

                return machineData[x].target;

            });

        const actual =
            labels.map(function (x) {

                return machineData[x].actual;

            });


        if (planActualChart) {

            planActualChart.destroy();

        }


        planActualChart =
            new Chart(

                document.getElementById(
                    'planActualChart'
                ),

                {

                    type: 'bar',

                    data: {

                        labels: labels,

                        datasets: [

                            {

                                label: 'Target Plan',

                                data: target

                            },

                            {

                                label: 'Actual',

                                data: actual

                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                position: 'top'
                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true

                            }

                        }

                    }

                }

            );

    }


    /* =====================================
       PLANNING TABLE
    ===================================== */

    function renderPlanningTable(data) {

        const grouped = {};


        data.forEach(function (row) {

            const key = row.id_plan;


            if (!grouped[key]) {

                grouped[key] = {

                    machine: row.no_mc,

                    product: row.nama_produk,

                    target: 0,

                    actual: 0,

                    status: row.status

                };

            }


            grouped[key].target +=
                Number(row.target_qty || 0);

            grouped[key].actual +=
                Number(row.actual_qty || 0);


            if (row.status === 'Pending') {

                grouped[key].status =
                    'Pending';

            }

        });


        let html = '';


        Object.keys(grouped).forEach(function (key) {

            const row = grouped[key];


            const achievement =
                row.target > 0
                    ? (row.actual / row.target) * 100
                    : 0;


            let statusClass =
                'status-running';


            if (row.status === 'Pending') {

                statusClass =
                    'status-pending';

            }


            if (row.status === 'Finish') {

                statusClass =
                    'status-finish';

            }


            html += `

                <tr>

                    <td>
                        INJ-${row.machine}
                    </td>

                    <td>
                        ${row.product || '-'}
                    </td>

                    <td>
                        ${numberFormat(row.target)}
                    </td>

                    <td>
                        ${numberFormat(row.actual)}
                    </td>

                    <td>
                        ${percentage(achievement)}
                    </td>

                    <td>
                        <span class="status ${statusClass}">
                            ${row.status}
                        </span>
                    </td>

                </tr>

            `;

        });


        $('#planningTable')
            .html(html);

    }


    /* =====================================
       RECORD TABLE
    ===================================== */

    function renderRecordTable(data) {

        let html = '';


        data.forEach(function (row, index) {

            const target =
                Number(row.target_qty || 0);

            const actual =
                Number(row.actual_qty || 0);

            const minus =
                Math.max(target - actual, 0);

            const achievement =
                target > 0
                    ? (actual / target) * 100
                    : 0;


            let statusClass =
                'status-running';


            if (row.status === 'Pending') {

                statusClass =
                    'status-pending';

            }


            if (row.status === 'Finish') {

                statusClass =
                    'status-finish';

            }


            html += `

                <tr>

                    <td>
                        ${index + 1}
                    </td>

                    <td>
                        MC-${row.no_mc}
                    </td>

                    <td>
                        ${row.nama_produk || '-'}
                    </td>

                    <td>
                        ${row.shift}
                    </td>

                    <td>
                        ${numberFormat(target)}
                    </td>

                    <td>
                        ${numberFormat(actual)}
                    </td>

                    <td>
                        ${numberFormat(minus)}
                    </td>

                    <td>
                        ${percentage(achievement)}
                    </td>

                    <td>
                        ${numberFormat(
                            row.downtime_minute
                        )} min
                    </td>

                    <td>

                        <span
                            class="status ${statusClass}"
                        >
                            ${row.status}
                        </span>

                    </td>

                    <td>
                        ${row.keterangan || '-'}
                    </td>

                </tr>

            `;

        });


        $('#recordTableBody')
            .html(html);

    }


    /* =====================================
       ACHIEVEMENT TREND
    ===================================== */

    function renderAchievementChart(data) {

        const labels = [];

        const values = [];


        data.forEach(function (row) {

            labels.push(
                'Shift ' + row.shift
            );


            const target =
                Number(row.target_qty || 0);

            const actual =
                Number(row.actual_qty || 0);


            values.push(

                target > 0
                    ? Number(
                        ((actual / target) * 100)
                        .toFixed(2)
                    )
                    : 0

            );

        });


        if (achievementChart) {

            achievementChart.destroy();

        }


        achievementChart =
            new Chart(

                document.getElementById(
                    'achievementChart'
                ),

                {

                    type: 'line',

                    data: {

                        labels: labels,

                        datasets: [

                            {

                                label: 'Achievement',

                                data: values,

                                tension: 0.3,

                                fill: false

                            },

                            {

                                label: 'Target',

                                data: labels.map(
                                    function () {
                                        return 100;
                                    }
                                ),

                                borderDash: [
                                    5,
                                    5
                                ],

                                tension: 0

                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        scales: {

                            y: {

                                min: 0,

                                max: 100,

                                ticks: {

                                    callback:
                                    function(value) {

                                        return value + '%';

                                    }

                                }

                            }

                        }

                    }

                }

            );

    }


    /* =====================================
       NG CHART
    ===================================== */

    function renderNgChart(data) {

        /*
         * Data NG belum tersedia.
         *
         * Chart tetap dibuat agar layout
         * sama seperti dashboard.
         */

        const labels =
            data.map(function(row) {

                return 'Shift ' + row.shift;

            });


        const ng =
            data.map(function() {

                return 0;

            });


        const defect =
            data.map(function() {

                return 0;

            });


        if (ngChart) {

            ngChart.destroy();

        }


        ngChart =
            new Chart(

                document.getElementById(
                    'ngChart'
                ),

                {

                    type: 'bar',

                    data: {

                        labels: labels,

                        datasets: [

                            {

                                label: 'NG',

                                data: ng

                            },

                            {

                                label: 'Defect',

                                data: defect

                            }

                        ]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        scales: {

                            y: {

                                beginAtZero: true

                            }

                        }

                    }

                }

            );

    }


    /* =====================================
       DOWNTIME PARETO
    ===================================== */

    function renderDowntimeChart(data) {

        const labels = [];

        const values = [];


        data.forEach(function (row) {

            const downtime =
                Number(
                    row.downtime_minute || 0
                );


            if (downtime > 0) {

                labels.push(
                    'Shift ' + row.shift
                );

                values.push(downtime);

            }

        });


        if (!labels.length) {

            labels.push('Tidak ada downtime');

            values.push(0);

        }


        if (downtimeChart) {

            downtimeChart.destroy();

        }


        downtimeChart =
            new Chart(

                document.getElementById(
                    'downtimeChart'
                ),

                {

                    type: 'bar',

                    data: {

                        labels: labels,

                        datasets: [

                            {

                                label:
                                    'Downtime (Menit)',

                                data: values

                            }

                        ]

                    },

                    options: {

                        indexAxis: 'y',

                        responsive: true,

                        maintainAspectRatio: false,

                        scales: {

                            x: {

                                beginAtZero: true

                            }

                        }

                    }

                }

            );

    }


    /* =====================================
       ATTENTION
    ===================================== */

    function renderAttention(data) {

        const pending =
            data.filter(function(row) {

                return row.status === 'Pending';

            });


        let html = '';


        if (!pending.length) {

            html = `

                <div class="attention-item">

                    <div class="attention-title">

                        <i class="fas fa-check-circle text-success"></i>

                        Tidak ada kendala

                    </div>

                    <div class="attention-detail">

                        Semua summary tidak memiliki status Pending.

                    </div>

                </div>

            `;

        }


        pending.forEach(function(row) {

            html += `

                <div class="attention-item">

                    <div class="attention-title">

                        <i class="fas fa-exclamation-circle text-warning"></i>

                        MC-${row.no_mc}
                        - Shift ${row.shift}

                        <span class="pending-badge">
                            Pending
                        </span>

                    </div>

                    <div class="attention-detail">

                        Produk :
                        ${row.nama_produk || '-'}

                        <br>

                        Kendala :
                        ${row.keterangan || '-'}

                        <br>

                        Downtime :
                        <b>
                            ${numberFormat(
                                row.downtime_minute
                            )} menit
                        </b>

                    </div>

                </div>

            `;

        });


        $('#attentionContainer')
            .html(html);

    }


    /* =====================================
       SEARCH
    ===================================== */

    $('#searchSummary').on(
        'keyup',
        function () {

            const keyword =
                $(this)
                .val()
                .toLowerCase();


            const filtered =
                allData.filter(function(row) {

                    return (

                        String(row.no_mc)
                            .toLowerCase()
                            .includes(keyword)

                        ||

                        String(row.nama_produk || '')
                            .toLowerCase()
                            .includes(keyword)

                        ||

                        String(row.no_part || '')
                            .toLowerCase()
                            .includes(keyword)

                        ||

                        String(row.status || '')
                            .toLowerCase()
                            .includes(keyword)

                        ||

                        String(row.shift)
                            .toLowerCase()
                            .includes(keyword)

                    );

                });


            renderDashboard(filtered);

        }
    );


    /* =====================================
       START
    ===================================== */

    loadSummary();

});

</script>

