function deleteAudit(
    idAudit
) {

    if (!idAudit) {

        Swal.fire(
            'Perhatian',
            'Pilih audit terlebih dahulu.',
            'warning'
        );

        return;

    }


    Swal.fire({

        title:
            'Hapus pelaksanaan audit?',

        text:
            'Data audit akan dihapus.',

        icon:
            'warning',

        showCancelButton:
            true,

        confirmButtonText:
            'Ya, Hapus',

        cancelButtonText:
            'Batal',

        confirmButtonColor:
            '#dc3545'

    }).then(
        function(result) {

            if (
                !result.isConfirmed
            ) {

                return;

            }


            $.ajax({

                url:
                    '/audit/delete/' +
                    idAudit,

                type:
                    'DELETE',

                success:
                    function(res) {

                        if (!res.success) {

                            Swal.fire(
                                'Gagal',
                                res.message ||
                                'Gagal menghapus audit',
                                'error'
                            );

                            return;

                        }


                        $('#auditDetailArea')
                            .hide();


                        selectedAuditId =
                            null;

                        selectedAuditData =
                            null;


                        Swal.fire({

                            icon:
                                'success',

                            title:
                                'Berhasil',

                            text:
                                res.message,

                            timer:
                                1300,

                            showConfirmButton:
                                false

                        });


                        loadAudit(
                            selectedCustomerId
                        );

                    },


                error:
                    function(xhr) {

                        console.error(
                            xhr.responseText
                        );


                        Swal.fire(
                            'Gagal',
                            xhr.responseJSON?.message ||
                            'Gagal menghapus audit',
                            'error'
                        );

                    }

            });

        }
    );

}


