<%- include("../partials/header") %>
<%- include("../partials/sideNavbar") %>

<style>

    .audit-page {
        padding: 20px;
    }

    .audit-header {
        margin-bottom: 25px;
    }

    .audit-header h3 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .audit-header p {
        color: #6c757d;
        margin-bottom: 0;
    }


    /* CUSTOMER */

    .customer-grid {
        display: grid;
        grid-template-columns:
            repeat(auto-fill, minmax(220px, 1fr));

        gap: 18px;
    }


    .customer-card {

        background: #fff;

        border: 1px solid #e5e7eb;

        border-radius: 12px;

        padding: 20px;

        cursor: pointer;

        transition: all .2s ease;

        box-shadow:
            0 2px 8px rgba(0,0,0,.04);
    }


    .customer-card:hover {

        transform: translateY(-3px);

        box-shadow:
            0 8px 20px rgba(0,0,0,.08);

        border-color: #007bff;
    }


    .customer-icon {

        width: 48px;
        height: 48px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: #eaf3ff;

        color: #007bff;

        font-size: 20px;

        margin-bottom: 15px;
    }


    .customer-name {

        font-size: 17px;

        font-weight: 700;

        margin-bottom: 5px;
    }


    .customer-plant {

        color: #6c757d;

        font-size: 13px;
    }


    /* AUDIT SECTION */

    #auditSection {
        display: none;
    }


    .section-title {

        font-size: 18px;

        font-weight: 700;

        margin-bottom: 15px;
    }


    .back-btn {

        cursor: pointer;

        color: #007bff;

        font-size: 14px;

        margin-bottom: 20px;

        display: inline-block;
    }


    /* YEAR */

    .year-tabs {

        display: flex;

        gap: 10px;

        flex-wrap: wrap;

        margin-bottom: 25px;
    }


    .year-tab {

        border: 1px solid #dee2e6;

        background: #fff;

        border-radius: 8px;

        padding: 8px 18px;

        cursor: pointer;

        font-weight: 600;

        font-size: 14px;
    }


    .year-tab.active {

        background: #007bff;

        color: #fff;

        border-color: #007bff;
    }


    /* AUDIT LIST */

    .audit-list {

        display: grid;

        grid-template-columns:
            repeat(auto-fill, minmax(280px, 1fr));

        gap: 15px;
    }


    .audit-card {

        background: #fff;

        border: 1px solid #e5e7eb;

        border-radius: 10px;

        padding: 18px;

        cursor: pointer;

        transition: .2s;
    }


    .audit-card:hover {

        border-color: #007bff;

        box-shadow:
            0 5px 15px rgba(0,0,0,.06);
    }


    .audit-date {

        color: #007bff;

        font-weight: 700;

        font-size: 13px;

        margin-bottom: 7px;
    }


    .audit-name {

        font-size: 16px;

        font-weight: 700;

        margin-bottom: 10px;
    }


    .audit-info {

        font-size: 13px;

        color: #6c757d;

        margin-bottom: 4px;
    }


    .audit-status {

        display: inline-block;

        padding: 4px 9px;

        border-radius: 20px;

        font-size: 11px;

        margin-top: 10px;

        background: #eaf3ff;

        color: #007bff;
    }


    /* DETAIL */

    #auditDetail {
        display: none;

        margin-top: 30px;
    }


    .detail-card {

        background: #fff;

        border: 1px solid #e5e7eb;

        border-radius: 12px;

        padding: 25px;
    }


    .detail-header {

        display: flex;

        justify-content: space-between;

        align-items: flex-start;

        margin-bottom: 25px;
    }


    .detail-title {

        font-size: 21px;

        font-weight: 700;

        margin-bottom: 5px;
    }


    .detail-subtitle {

        color: #6c757d;

        font-size: 13px;
    }


    .detail-grid {

        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 15px;

        margin-bottom: 25px;
    }


    .detail-item {

        background: #f8f9fa;

        border-radius: 8px;

        padding: 13px;
    }


    .detail-label {

        color: #6c757d;

        font-size: 11px;

        margin-bottom: 4px;
    }


    .detail-value {

        font-weight: 600;

        font-size: 14px;
    }


    @media(max-width: 768px) {

        .detail-grid {

            grid-template-columns:
                repeat(2, 1fr);

        }

    }

</style>


<div class="content-wrapper">

    <div class="audit-page">

        <!-- HEADER -->

        <div class="audit-header">

            <h3>
                <i class="fas fa-clipboard-check mr-2"></i>
                Audit Management
            </h3>

            <p>
                Kelola dan akses pelaksanaan audit berdasarkan customer.
            </p>

        </div>


        <!-- CUSTOMER SECTION -->

        <div id="customerSection">

            <div class="section-title">

                Customer

            </div>


            <div class="customer-grid">

                <% customers.forEach(customer => { %>

                    <div
                        class="customer-card"
                        onclick="
                            selectCustomer(
                                '<%= customer.id_customer %>',
                                '<%= customer.nama_customer %>',
                                '<%= customer.plant %>'
                            )
                        "
                    >

                        <div class="customer-icon">

                            <i class="fas fa-building"></i>

                        </div>


                        <div class="customer-name">

                            <%= customer.nama_customer %>

                        </div>


                        <div class="customer-plant">

                            <i class="fas fa-industry mr-1"></i>

                            <%= customer.plant || '-' %>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>


        <!-- AUDIT SECTION -->

        <div id="auditSection">

            <div
                class="back-btn"
                onclick="backToCustomer()"
            >

                <i class="fas fa-arrow-left mr-1"></i>

                Kembali ke Customer

            </div>


            <div class="section-title">

                <span id="selectedCustomer"></span>

                <small
                    id="selectedPlant"
                    class="text-muted ml-2"
                ></small>

            </div>


            <!-- YEAR -->

            <div
                class="year-tabs"
                id="yearTabs"
            ></div>


            <!-- AUDIT LIST -->

            <div
                class="audit-list"
                id="auditList"
            ></div>


            <!-- DETAIL -->

            <div id="auditDetail">

                <div class="detail-card">

                    <div class="detail-header">

                        <div>

                            <div
                                class="detail-title"
                                id="detailAuditName"
                            >
                                -
                            </div>

                            <div
                                class="detail-subtitle"
                                id="detailAuditDate"
                            >
                                -
                            </div>

                        </div>

                        <button
                            class="btn btn-sm btn-outline-secondary"
                            onclick="closeDetail()"
                        >

                            <i class="fas fa-times mr-1"></i>

                            Tutup

                        </button>

                    </div>


                    <div class="detail-grid">

                        <div class="detail-item">

                            <div class="detail-label">
                                CUSTOMER
                            </div>

                            <div
                                class="detail-value"
                                id="detailCustomer"
                            >
                                -
                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-label">
                                PLANT
                            </div>

                            <div
                                class="detail-value"
                                id="detailPlant"
                            >
                                -
                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-label">
                                PIC
                            </div>

                            <div
                                class="detail-value"
                                id="detailPic"
                            >
                                -
                            </div>

                        </div>


                        <div class="detail-item">

                            <div class="detail-label">
                                STATUS
                            </div>

                            <div
                                class="detail-value"
                                id="detailStatus"
                            >
                                -
                            </div>

                        </div>

                    </div>


                    <!-- DOCUMENT AREA -->

                    <div class="section-title">

                        Dokumen Audit

                    </div>


                    <div
                        class="alert alert-light border"
                    >

                        <i class="fas fa-folder-open mr-2"></i>

                        Preparation & Evidence

                        <div
                            class="text-muted mt-1"
                            style="font-size:12px;"
                        >

                            Dokumen audit akan ditampilkan
                            pada bagian ini.

                        </div>

                    </div>


                    <!-- RESULT -->

                    <div class="section-title mt-4">

                        Result

                    </div>


                    <div
                        class="alert alert-light border"
                    >

                        <i class="fas fa-chart-bar mr-2"></i>

                        Hasil Audit

                        <div
                            class="text-muted mt-1"
                            style="font-size:12px;"
                        >

                            Fitur penilaian, temuan dan
                            tindakan perbaikan akan
                            dikembangkan pada bagian Result.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

let selectedCustomerId = null;


/*
|--------------------------------------------------------------------------
| PILIH CUSTOMER
|--------------------------------------------------------------------------
*/

function selectCustomer(
    idCustomer,
    namaCustomer,
    plant
) {

    selectedCustomerId =
        idCustomer;


    $('#selectedCustomer')
        .text(namaCustomer);


    $('#selectedPlant')
        .text(
            plant
                ? `• ${plant}`
                : ''
        );


    $('#customerSection')
        .hide();


    $('#auditSection')
        .fadeIn(200);


    loadYears(idCustomer);

}


/*
|--------------------------------------------------------------------------
| LOAD TAHUN
|--------------------------------------------------------------------------
*/

function loadYears(idCustomer) {

    $('#yearTabs')
        .html(`
            <div class="text-muted">
                <i class="fas fa-spinner fa-spin mr-1"></i>
                Mengambil data tahun...
            </div>
        `);


    $.ajax({

        url:
            `/audit/customer/${idCustomer}/years`,

        method: 'GET',

        success: function(response) {

            if (!response.success) {

                return;

            }


            const years =
                response.data;


            $('#yearTabs').empty();


            if (years.length === 0) {

                $('#yearTabs').html(`
                    <div class="text-muted">
                        Belum ada data audit.
                    </div>
                `);

                $('#auditList').empty();

                return;

            }


            years.forEach(function(item, index) {

                $('#yearTabs').append(`

                    <div
                        class="year-tab
                        ${index === 0 ? 'active' : ''}"
                        onclick="
                            selectYear(
                                ${item.tahun},
                                this
                            )
                        "
                    >

                        ${item.tahun}

                    </div>

                `);

            });


            // tampilkan tahun terbaru
            loadAuditByYear(
                years[0].tahun
            );

        },

        error: function() {

            Swal.fire(
                'Error',
                'Gagal mengambil tahun audit.',
                'error'
            );

        }

    });

}


/*
|--------------------------------------------------------------------------
| PILIH TAHUN
|--------------------------------------------------------------------------
*/

function selectYear(
    tahun,
    element
) {

    $('.year-tab')
        .removeClass('active');


    $(element)
        .addClass('active');


    loadAuditByYear(tahun);

}


/*
|--------------------------------------------------------------------------
| LOAD AUDIT
|--------------------------------------------------------------------------
*/

function loadAuditByYear(tahun) {

    $('#auditList').html(`
        <div class="text-muted py-3">
            <i class="fas fa-spinner fa-spin mr-1"></i>
            Mengambil data audit...
        </div>
    `);


    $('#auditDetail')
        .hide();


    $.ajax({

        url:
            `/audit/customer/${selectedCustomerId}/year/${tahun}`,

        method: 'GET',

        success: function(response) {

            if (!response.success) {
                return;
            }


            renderAudit(
                response.data
            );

        },

        error: function() {

            Swal.fire(
                'Error',
                'Gagal mengambil data audit.',
                'error'
            );

        }

    });

}


/*
|--------------------------------------------------------------------------
| RENDER AUDIT
|--------------------------------------------------------------------------
*/

function renderAudit(data) {

    const container =
        $('#auditList');


    container.empty();


    if (!data.length) {

        container.html(`

            <div
                class="text-center text-muted py-5"
            >

                <i
                    class="fas fa-calendar-times fa-3x mb-3"
                ></i>

                <div>
                    Belum ada pelaksanaan audit
                    pada tahun ini.
                </div>

            </div>

        `);

        return;

    }


    data.forEach(function(audit) {

        container.append(`

            <div
                class="audit-card"
                onclick="
                    showAuditDetail(
                        ${audit.id_audit}
                    )
                "
            >

                <div class="audit-date">

                    <i class="far fa-calendar-alt mr-1"></i>

                    ${audit.tanggal_format}

                </div>


                <div class="audit-name">

                    ${audit.nama_audit}

                </div>


                <div class="audit-info">

                    <i class="fas fa-user mr-1"></i>

                    PIC:
                    ${audit.pic || '-'}

                </div>


                <span class="audit-status">

                    ${audit.status || '-'}

                </span>

            </div>

        `);

    });

}


/*
|--------------------------------------------------------------------------
| DETAIL AUDIT
|--------------------------------------------------------------------------
*/

function showAuditDetail(idAudit) {

    $('#auditDetail')
        .show();


    $('html, body')
        .animate({

            scrollTop:
                $('#auditDetail')
                    .offset()
                    .top - 80

        }, 300);


    $('#detailAuditName')
        .text('Loading...');


    $.ajax({

        url:
            `/audit/detail/${idAudit}`,

        method: 'GET',

        success: function(response) {

            if (!response.success) {

                return;

            }


            const audit =
                response.data;


            $('#detailAuditName')
                .text(
                    audit.nama_audit
                );


            $('#detailAuditDate')
                .text(
                    audit.tanggal_format
                );


            $('#detailCustomer')
                .text(
                    audit.nama_customer
                );


            $('#detailPlant')
                .text(
                    audit.plant || '-'
                );


            $('#detailPic')
                .text(
                    audit.pic || '-'
                );


            $('#detailStatus')
                .text(
                    audit.status || '-'
                );

        },

        error: function() {

            Swal.fire(
                'Error',
                'Gagal mengambil detail audit.',
                'error'
            );

        }

    });

}


/*
|--------------------------------------------------------------------------
| CLOSE DETAIL
|--------------------------------------------------------------------------
*/

function closeDetail() {

    $('#auditDetail')
        .slideUp(150);

}


/*
|--------------------------------------------------------------------------
| BACK CUSTOMER
|--------------------------------------------------------------------------
*/

function backToCustomer() {

    selectedCustomerId = null;


    $('#auditSection')
        .hide();


    $('#auditDetail')
        .hide();


    $('#customerSection')
        .fadeIn(200);

}

</script>


<%- include("../partials/footer") %>