/* =========================================================
   FORMAT TANGGAL
========================================================= */

function formatTanggal(
    tanggal
) {

    if (!tanggal) {

        return '-';

    }


    const date =
        new Date(
            tanggal
        );


    if (
        isNaN(
            date.getTime()
        )
    ) {

        return '-';

    }


    return date.toLocaleDateString(
        'id-ID',
        {

            timeZone:
                'Asia/Jakarta',

            day:
                '2-digit',

            month:
                'long',

            year:
                'numeric'

        }
    );

}


/* =========================================================
   STATUS
========================================================= */

function setStatus(
    element,
    status
) {

    element
        .removeClass(
            'status-plan',
            'status-open',
            'status-close'
        );


    const value =
        String(
            status || '-'
        ).toUpperCase();


    element
        .text(
            value
        );


    if (
        value === 'PLAN'
    ) {

        element.addClass(
            'status-plan'
        );

    }


    if (
        value === 'OPEN'
    ) {

        element.addClass(
            'status-open'
        );

    }


    if (
        value === 'CLOSE'
    ) {

        element.addClass(
            'status-close'
        );

    }

}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHtml(
    value
) {

    return String(
        value ?? ''
    )

        .replace(
            /&/g,
            '&amp;'
        )

        .replace(
            /</g,
            '&lt;'
        )

        .replace(
            />/g,
            '&gt;'
        )

        .replace(
            /"/g,
            '&quot;'
        )

        .replace(
            /'/g,
            '&#039;'
        );

}

