/* =========================================================
   MASTER KATEGORI + DEPARTEMEN
========================================================= */

function loadMasterDokumen(
    selectedKategori = '',
    selectedDept = ''
) {

    $('#kategoriDokumen')
        .html(`

            <option value="">
                Memuat kategori...
            </option>

        `);


    $('#deptDokumen')
        .html(`

            <option value="">
                Memuat departemen...
            </option>

        `);


    $.ajax({

        url:
            '/audit-dokumen/master',

        type:
            'GET',

        dataType:
            'json',


        success:
            function(res) {

                if (!res.success) {

                    Swal.fire(
                        'Gagal',
                        res.message ||
                        'Gagal mengambil master data',
                        'error'
                    );

                    return;

                }


                let kategoriHtml = `

                    <option value="">
                        -- Pilih Kategori --
                    </option>

                `;


                (res.kategori || [])
                    .forEach(
                        function(item) {

                            const selected =
                                String(
                                    item.id_kategori
                                ) ===
                                String(
                                    selectedKategori
                                )
                                    ? 'selected'
                                    : '';


                            kategoriHtml += `

                                <option
                                    value="${item.id_kategori}"
                                    ${selected}
                                >

                                    ${escapeHtml(
                                        item.nama_kategori
                                    )}

                                </option>

                            `;

                        }
                    );


                $('#kategoriDokumen')
                    .html(
                        kategoriHtml
                    );


                let deptHtml = `

                    <option value="">
                        -- Pilih Departemen --
                    </option>

                `;


                (res.departemen || [])
                    .forEach(
                        function(item) {

                            const selected =
                                String(
                                    item.id_dept
                                ) ===
                                String(
                                    selectedDept
                                )
                                    ? 'selected'
                                    : '';


                            deptHtml += `

                                <option
                                    value="${item.id_dept}"
                                    ${selected}
                                >

                                    ${escapeHtml(
                                        item.nama_dept
                                    )}

                                </option>

                            `;

                        }
                    );


                $('#deptDokumen')
                    .html(
                        deptHtml
                    );

            },


        error:
            function(xhr) {

                console.error(
                    xhr.responseText
                );


                $('#kategoriDokumen')
                    .html(`

                        <option value="">
                            Gagal memuat kategori
                        </option>

                    `);


                $('#deptDokumen')
                    .html(`

                        <option value="">
                            Gagal memuat departemen
                        </option>

                    `);

            }

    });

}


