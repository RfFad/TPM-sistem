/* =========================================================
   REFRESH
========================================================= */

$('#btnRefresh')
    .on(
        'click',
        function() {

            const icon =
                $(this).find('i');


            icon.addClass(
                'fa-spin'
            );


            setTimeout(
                function() {

                    icon.removeClass(
                        'fa-spin'
                    );

                },
                700
            );

        }
    );


/* =========================================================
   QUICK FILTER
========================================================= */

$('.quick-buttons button')
    .on(
        'click',
        function() {

            $('.quick-buttons button')
                .removeClass('active');


            $(this)
                .addClass('active');

        }
    );

